# Copy to .env and fill in. The gitignored .env at the repo root holds the
# preserved OPENROUTER_API_KEY; these are the phase-16 additions.

# --- database (v3, phase 16) ---
# The compose service defaults (ddesign/ddesign) match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://ddesign:ddesign@localhost:5432/ddesign

# --- Better Auth (v3, phase 16) ---
# REQUIRED. No default secret is ever a permissive fallback in the credential
# path (fail closed). Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=
# REQUIRED in production; dev can default to http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# --- S3 / MinIO (v3, phase 18) ---
# storage.ts points at S3 via the AWS SDK; the endpoint is the one infra knob.
# Dev: MinIO in docker-compose (S3_ENDPOINT=http://localhost:9000, the compose
# MINIO_ROOT creds). Prod: leave S3_ENDPOINT unset so the SDK resolves the real
# regional endpoint, with real AWS credentials in the environment.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ddesign-assets

# --- billing (v3, phase 19) ---
# The kill switch: a global spend ceiling that halts spend (fail-closed). Set
# to 1 to refuse all quota-consuming actions regardless of the account's quota
# (security/infrastructure.md "Denial of wallet").
KILL_SWITCH=
# The static/testing plan knob. Stripe is deferred; FORCE_PLAN flips the whole
# instance to 'free' or 'paid' so the tiers are testable without a Stripe
# account. A future Stripe webhook flips the per-row plan instead. Unset =
# free by default (never a permissive upgrade).
FORCE_PLAN=
