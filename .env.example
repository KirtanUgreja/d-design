# Copy to .env and fill in. .env is gitignored.

# REQUIRED for any live call. The one model gateway.
OPENROUTER_API_KEY=

# Optional: override the pinned model per role (api/settings.py).
# MODEL_WRITING=anthropic/claude-sonnet-5.5
# MODEL_DESIGN=deepseek/deepseek-v4.1-flash
# MODEL_CHEAP=anthropic/claude-haiku-5.5          the interview and speaker notes
# MODEL_PROVIDERS=anthropic/claude-haiku-5.5=amazon-bedrock   pin a model to one provider

# Neon Postgres (build day). Paste the connection string from Neon → Connect.
# Keep "-pooler" in the host if Neon shows it; the code derives the direct host for migrations.
DATABASE_URL=

# Who may sign up on the live link, comma-separated.
ALLOWED_EMAILS=

# Derived from DATABASE_URL: the same host and user, one database each.
# Python (SQLAlchemy + Alembic) owns "app"; Better Auth owns "auth". Pooled host at runtime.
APP_DATABASE_URL=
AUTH_DATABASE_URL=

# Better Auth (web). Generate the secret: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
