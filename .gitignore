.DS_Store
notes.txt
skills-lock.json

# .claude/ is personal except settings.json, which is the shared project config
# (hooks that enforce the rules in AGENTS.md). Keep that one tracked.
.claude/*
!.claude/settings.json

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node (web/ returns in phase 27)
node_modules/
web/.next/

# Bench runs: screenshots, walls, ledgers. The summary row in
# bench/results.md is what gets committed (docs/v4/bench.md).
bench/runs/

# Local env
.env
.env.local

.commandcode

# One-shot baseline screenshots: regenerated from the committed .html files
# by `cli baseline`.
bench/baselines/oneshot/*/

# The file store (store/files.py): decks, events, jobs. Never committed.
data/
