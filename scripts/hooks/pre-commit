#!/usr/bin/env bash
# The gate. A commit that fails any step does not land.
#
#   api  (Python)                      web  (TypeScript) — returns in phase 27
#   1. format    — Ruff format         format, lint, tsc, and the OpenAPI types
#   2. lint      — Ruff                regenerating with no diff
#   3. typecheck — mypy --strict
#   4. tests     — pytest
#
# ponytail: one hook that dispatches by staged path. Two hook managers cannot
# both own .git/hooks, and this is one repo.
#
# Installed by `scripts/setup.sh` via core.hooksPath, so it is versioned.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged" ] || exit 0

touches() { grep -qE "$1" <<<"$staged"; }

fail=0
step() {
  local label=$1; shift
  local out
  if ! out=$("$@" 2>&1); then
    printf '\n✗ %s\n%s\n' "$label" "$out" >&2
    fail=1
  else
    printf '  ✓ %s\n' "$label"
  fi
}

# bench/briefs are read by the api tests, so a brief change runs them too.
if touches '^api/|^bench/briefs/'; then
  echo 'api'
  step 'ruff format' uv run --project api ruff format --check api
  step 'ruff'        uv run --project api ruff check api
  step 'mypy'        env -C api uv run mypy
  step 'pytest'      env -C api uv run pytest -q
fi

if touches '\.md$'; then
  echo 'docs'
  step 'docs' ./scripts/check-docs.sh
fi

[ "$fail" -eq 0 ] || printf '\nthe gate is red — the commit did not land.\n' >&2
exit "$fail"
