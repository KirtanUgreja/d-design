# Copy to .env. Matches docker-compose.yml at the repo root.

# app_user has no bypassrls, so every policy in the migrations applies to it.
DATABASE_URL=postgresql+asyncpg://app_user:app_user@localhost:5432/ddesign

# DDL only, and a different role on purpose. Alembic never connects as app_user.
MIGRATION_DATABASE_URL=postgresql+asyncpg://migrator:migrator@localhost:5432/ddesign

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=d-design
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# v1 has one user. `as_user` takes this exactly as v3 will take a resolved
# session's user id — the wrapper does not know the difference, which is the
# whole reason for building it now.
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001

# No default model for any phase — a wrong default silently spends money on a
# model nobody chose (docs/techstack/ai-stack.md). Fill in a real key before
# wiring live calls; a placeholder is enough for tests, which mock the call.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_INTAKE=
OPENROUTER_MODEL_DIRECTOR=
OPENROUTER_MODEL_BUILD=
OPENROUTER_MODEL_EDIT=
