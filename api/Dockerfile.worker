# The worker service: no inbound port. The only service holding the model key,
# and the only one with Chromium (QA, thumbnails, PDF).
FROM public.ecr.aws/docker/library/python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_FROZEN=1 UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=never DATA_DIR=/tmp/data PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY pyproject.toml uv.lock ./
RUN uv sync --no-install-project
RUN uv run --no-sync playwright install --with-deps chromium
COPY . .
RUN uv sync
CMD ["uv", "run", "--no-sync", "python", "worker.py"]
